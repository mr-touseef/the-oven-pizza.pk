generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MenuCategory {
  id           String      @id @default(cuid())
  section      MenuSection
  slug         String      @unique
  name         String
  tagline      String?
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        MenuItem[]

  @@index([section])
  @@index([displayOrder])
}

model MenuItem {
  id           String          @id @default(cuid())
  categoryId   String
  name         String
  description  String?
  badge        String?
  imageUrl     String?
  isAvailable  Boolean         @default(true)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  category     MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  prices       MenuItemPrice[]

  @@index([categoryId])
  @@index([displayOrder])
}

model MenuItemPrice {
  id           String   @id @default(cuid())
  menuItemId   String
  label        String
  priceRs      Int
  displayOrder Int      @default(0)
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model Deal {
  id            String   @id @default(cuid())
  title         String
  description   String
  priceRs       Int
  activeWindow  String?
  includedItems String[] @default([])
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
}

model Branch {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  address           String
  phone             String?
  /// Optional second contact number for the branch (e.g. a WhatsApp/mobile line).
  phone2            String?
  photoUrl          String
  isActive          Boolean            @default(true)
  displayOrder      Int                @default(0)
  /// Login username for this branch's admin/orders dashboard. Null = admin
  /// login disabled for this branch.
  adminUsername     String?            @unique
  /// Salted+hashed admin password (scrypt, "salt:hash" hex). Never store plaintext.
  passwordHash      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  adminOTPs         AdminOTP[]
  orders            Order[]
  pushSubscriptions PushSubscription[]

  @@index([displayOrder])
}

model Order {
  id              String      @id @default(cuid())
  branchId        String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  subtotal        Int
  discountPercent Int         @default(0)
  discountAmount  Int         @default(0)
  total           Int
  status          OrderStatus @default(PENDING)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deliveryAddress String?
  isAdminOrder    Boolean     @default(false)
  orderType       OrderType   @default(DELIVERY)
  branch          Branch?     @relation(fields: [branchId], references: [id])
  lines           OrderLine[]

  @@index([status])
  @@index([createdAt])
  @@index([branchId])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  kind      String
  refId     String
  name      String
  sizeLabel String?
  unitPrice Int
  quantity  Int
  lineTotal Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String?
  type      InquiryType   @default(GENERAL)
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppSettings {
  id              String   @id @default("singleton")
  discountPercent Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String             @id @default(cuid())
  branchId  String
  endpoint  String             @unique
  p256dh    String
  auth      String
  createdAt DateTime           @default(now())
  role      PushSubscriberRole @default(CUSTOMER)
  orderId   String?
  branch    Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([role])
  @@index([orderId])
}

model Whitelist {
  id        String   @id @default(cuid())
  type      String
  value     String   @unique
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model AdminOTP {
  id          String   @id @default(cuid())
  branchId    String
  contact     String
  otp         String
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([expiresAt])
  @@index([contact])
}

enum MenuSection {
  PIZZA
  BURGER
  SANDWICH
  SIDE
  WING
  SHAWARMA
  COFFEE
  DRINK
  DESSERT
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

enum InquiryType {
  ORDER
  RESERVATION
  FEEDBACK
  GENERAL
}

enum InquiryStatus {
  NEW
  CONTACTED
  RESOLVED
}

enum PushSubscriberRole {
  CUSTOMER
  ADMIN
}
