# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma at runtime (use the pooled
# connection string if your provider offers one, e.g. Neon/Supabase pgbouncer).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/the_oven_pizza?schema=public"

# Direct (non-pooled) connection string, required by `prisma migrate` when
# your DATABASE_URL points at a connection pooler. If your provider does not
# use a separate pooler, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/the_oven_pizza?schema=public"

# ── Site ─────────────────────────────────────────────────────────────────
# Public base URL of the deployed site — used for SEO metadata, Open Graph
# tags, sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://theovenpizza.com"

# Restaurant contact details surfaced in the UI and in JSON-LD structured data.
NEXT_PUBLIC_RESTAURANT_PHONE_PRIMARY="0304-1114303"
NEXT_PUBLIC_RESTAURANT_PHONE_SECONDARY="0300-1580250"
NEXT_PUBLIC_RESTAURANT_ADDRESS="Zahid Iqbal Chowk, Chichawatni, Punjab, Pakistan"

# ── Security ─────────────────────────────────────────────────────────────
# Random 32+ character secret used to sign the anti-spam token issued to the
# contact/order form. Generate with: openssl rand -base64 32
FORM_SIGNING_SECRET="replace-with-a-long-random-string"

# Optional: comma separated list of allowed origins for the API routes when
# the site is embedded/proxied from another domain. Leave unset to allow the
# NEXT_PUBLIC_SITE_URL origin only.
ALLOWED_ORIGINS=""

# Random 32+ character secret used to sign branch admin login sessions
# (/admin/login). Required in production — without it, sessions fall back to
# an insecure development-only secret. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
